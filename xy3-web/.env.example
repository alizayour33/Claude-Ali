# Resend (https://resend.com) API key used by /api/quote to email inquiries
RESEND_API_KEY=
# Where quote requests are delivered
QUOTE_TO_EMAIL=sales@yourdomain.com
# Verified sender in Resend, e.g. "X&Y3 Website <quotes@yourdomain.com>"
QUOTE_FROM_EMAIL=
# WhatsApp number in international format, digits only (shown as fallback)
NEXT_PUBLIC_WHATSAPP=000000000000
