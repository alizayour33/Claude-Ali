# Final site address (used for SEO, sitemap and canonical URLs)
NEXT_PUBLIC_SITE_URL=https://www.xandy3.com

# --- Forms (Start a Project, Support, Partner) are emailed through Resend: https://resend.com ---
RESEND_API_KEY=
# Verified sender, e.g. "X&Y3 Website <website@xandy3.com>"
LEADS_FROM_EMAIL=
# Lead routing by inquiry type. LEADS_TO_EMAIL is the fallback for any type left empty.
LEADS_TO_EMAIL=
LEADS_SALES_EMAIL=
LEADS_SUPPORT_EMAIL=
LEADS_PARTNER_EMAIL=
# Optional routing by country (lowercase country name -> inbox), as JSON:
# LEADS_COUNTRY_ROUTES={"united arab emirates":"gulf@xandy3.com"}

# Show the info@/sales@/support@ addresses on the Contact page once the domain email is live
NEXT_PUBLIC_EMAILS_LIVE=false

# Google Analytics 4 measurement ID (optional). A consent banner appears when this is set.
NEXT_PUBLIC_GA_ID=
