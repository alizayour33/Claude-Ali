{
  "name": "manhaj",
  "version": "1.0.0",
  "private": true,
  "description": "منهاج — منصة تعليمية للمناهج الشرعية مقسمة حسب السنوات والأعمار",
  "type": "commonjs",
  "main": "server/index.js",
  "scripts": {
